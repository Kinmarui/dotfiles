# --- remote servers ----------------------------------------------------------
# Reach servers whose Azure network security group denies inbound by default:
# repoint this machine's personal allow rule(s) at the *current* public IP on the
# target's NSG, then connect.
#
# All identity/topology is private and lives in the dotfiles-private overlay
# (shell/private.sh, symlinked next to this file). It is expected to define:
#     AZ_SSH_USER="<az local user>"
#     declare -gA DMOSH_HOSTS=( [alias]="<vm> [resource-group] [connect-host]" ... )
#     AZ_IP_RULES=( "<rule-name> <priority> <protocol> <port(s)>" ... )
# The alias (map key) is whatever you want to type. resource-group defaults to
# "<vm>-rg"; connect-host (used by mosh/ssh) defaults to <vm>. Without the map,
# the whitelist step is skipped and dmosh just falls back to mosh.
declare -gA DMOSH_HOSTS 2>/dev/null

# _dmosh_lookup <name> : if <name> is a DMOSH_HOSTS alias, echo the resolved
# "<vm> <resource-group> <connect-host>" (defaults filled in) and return 0;
# otherwise return 1 so callers treat <name> as a plain, non-Azure host.
_dmosh_lookup() {
  local spec="${DMOSH_HOSTS[$1]:-}" vm rg host
  [ -n "$spec" ] || return 1
  read -r vm rg host <<<"$spec"
  printf '%s %s %s\n' "$vm" "${rg:-${vm}-rg}" "${host:-$vm}"
}

# az_vm_allow_current_ip <host> [resource-group] : point each rule in AZ_IP_RULES
# at this machine's current public IP, on every NSG in the target's resource
# group. <host> may be a DMOSH_HOSTS alias (resolved to its VM + resource group)
# or a literal VM name (RG defaults to "<host>-rg", or the 2nd argument if given).
# Existing rules are updated in place; missing ones are created. These are named,
# long-lived per-user rules (one IP at a time), so reconnecting from a new
# network just moves the source.
az_vm_allow_current_ip() {
  local name="$1" vm rg info
  [ -n "$name" ] || { echo "usage: az_vm_allow_current_ip <host> [resource-group]" >&2; return 2; }
  if [ -n "${2:-}" ]; then
    vm="$name"; rg="$2"                       # explicit vm + rg (from dmosh/azzh)
  elif info="$(_dmosh_lookup "$name")"; then
    read -r vm rg _ <<<"$info"                # alias -> mapped vm + resource group
  else
    vm="$name"; rg="${name}-rg"               # literal vm, default resource group
  fi
  command -v az >/dev/null 2>&1 || { echo "az CLI not installed" >&2; return 1; }
  local ip; ip="$(curl -fsS https://api.ipify.org)" \
    || { echo "could not determine current public IP" >&2; return 1; }
  # Default to a single mosh rule if the overlay didn't define any.
  local -a rules=("${AZ_IP_RULES[@]}")
  [ "${#rules[@]}" -gt 0 ] && [ -n "${rules[0]}" ] \
    || rules=("AllowMoshFrom${AZ_SSH_USER:-$USER} 1100 Udp 60000-61000")
  echo "current IP: ${ip}"
  local nsg name prio proto ports spec found=0
  while IFS= read -r nsg; do
    [ -n "$nsg" ] || continue
    found=1
    for spec in "${rules[@]}"; do
      read -r name prio proto ports <<<"$spec"
      # Update the rule's source to our IP; create it (with full spec) if absent.
      if az network nsg rule update -g "$rg" --nsg-name "${nsg##*/}" --name "$name" \
           --source-address-prefixes "${ip}/32" >/dev/null 2>&1 \
      || az network nsg rule create -g "$rg" --nsg-name "${nsg##*/}" --name "$name" \
           --priority "$prio" --direction Inbound --access Allow --protocol "$proto" \
           --source-address-prefixes "${ip}/32" --destination-port-ranges "$ports" \
           >/dev/null 2>&1; then
        echo "  ${name}: ${ip} on ${nsg##*/}"
      else
        echo "  FAILED to set ${name} on ${nsg##*/}" >&2
      fi
    done
  done < <(az network nic list -g "$rg" \
             --query "[].networkSecurityGroup.id" -o tsv 2>/dev/null | sort -u)
  [ "$found" = 1 ] || { echo "no NSG found in resource group '${rg}'" >&2; return 1; }
}

# dmosh <host> [mosh args...] : if <host> is a known Azure alias, open the current
# IP on its NSG first, then mosh to the resolved connect-host. Unknown hosts just
# mosh directly (so plain SSH aliases keep working).
dmosh() {
  local name="$1"
  [ -n "$name" ] || { echo "usage: dmosh <host> [mosh args...]" >&2; return 2; }
  shift
  command -v mosh >/dev/null 2>&1 || { echo "mosh not installed" >&2; return 1; }
  local info vm rg host
  if info="$(_dmosh_lookup "$name")"; then
    read -r vm rg host <<<"$info"
    az_vm_allow_current_ip "$vm" "$rg" || echo "dmosh: whitelist failed, connecting anyway" >&2
    mosh "$host" "$@"
  else
    mosh "$name" "$@"
  fi
}

# azzh <host> [ssh args...] : Azure-native SSH (AAD/certificate auth via
# `az ssh vm`) to a known Azure alias, whitelisting the current IP on its NSG
# first. Needs an entry in DMOSH_HOSTS (the private overlay).
azzh() {
  local name="$1"
  [ -n "$name" ] || { echo "usage: azzh <host> [ssh args...]" >&2; return 2; }
  shift
  command -v az >/dev/null 2>&1 || { echo "az CLI not installed" >&2; return 1; }
  local info vm rg host
  info="$(_dmosh_lookup "$name")" \
    || { echo "azzh: '$name' is not a known Azure host (see DMOSH_HOSTS)" >&2; return 1; }
  read -r vm rg host <<<"$info"
  az_vm_allow_current_ip "$vm" "$rg" || echo "azzh: whitelist failed, connecting anyway" >&2
  az ssh vm -g "$rg" -n "$vm" --local-user "${AZ_SSH_USER:-$USER}" "$@"
}
