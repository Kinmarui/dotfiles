# --- remote servers ----------------------------------------------------------
# Reach servers whose Azure network security group denies inbound by default:
# repoint this machine's personal allow rule(s) at the *current* public IP on the
# target's NSG, then connect.
#
# All identity/topology is private and lives in the dotfiles-private overlay
# (shell/private.sh, symlinked next to this file). It is expected to define:
#     AZ_SSH_USER="<az local user>"
#     declare -gA DMOSH_HOSTS=( [name]="<vm-name> <resource-group>" ... )
#     AZ_IP_RULES=( "<rule-name> <priority> <protocol> <port(s)>" ... )
# Without it, the whitelist step is skipped and dmosh just falls back to mosh.
declare -gA DMOSH_HOSTS 2>/dev/null

# az_vm_allow_current_ip <vm> [resource-group] : point each rule in AZ_IP_RULES
# at this machine's current public IP, on every NSG in the VM's resource group.
# Existing rules are updated in place; missing ones are created. RG defaults to
# "<vm>-rg". These are named, long-lived per-user rules (one IP at a time), not
# a new rule per IP — so reconnecting from a new network just moves the source.
az_vm_allow_current_ip() {
  local vm="$1" rg="${2:-${1}-rg}"
  [ -n "$vm" ] || { echo "usage: az_vm_allow_current_ip <vm> [resource-group]" >&2; return 2; }
  command -v az >/dev/null 2>&1 || { echo "az CLI not installed" >&2; return 1; }
  local ip; ip="$(curl -fsS https://api.ipify.org)" \
    || { echo "could not determine current public IP" >&2; return 1; }
  # Default to a single mosh rule if the overlay didn't define any.
  local -a rules=("${AZ_IP_RULES[@]}")
  [ "${#rules[@]}" -gt 0 ] && [ -n "${rules[0]}" ] \
    || rules=("AllowMoshFrom${AZ_SSH_USER:-$USER} 1100 Udp 60000-61000")
  echo "current IP: ${ip}"
  local nsg name prio proto ports spec found=0
  while IFS= read -r nsg; do
    [ -n "$nsg" ] || continue
    found=1
    for spec in "${rules[@]}"; do
      read -r name prio proto ports <<<"$spec"
      # Update the rule's source to our IP; create it (with full spec) if absent.
      if az network nsg rule update -g "$rg" --nsg-name "${nsg##*/}" --name "$name" \
           --source-address-prefixes "${ip}/32" >/dev/null 2>&1 \
      || az network nsg rule create -g "$rg" --nsg-name "${nsg##*/}" --name "$name" \
           --priority "$prio" --direction Inbound --access Allow --protocol "$proto" \
           --source-address-prefixes "${ip}/32" --destination-port-ranges "$ports" \
           >/dev/null 2>&1; then
        echo "  ${name}: ${ip} on ${nsg##*/}"
      else
        echo "  FAILED to set ${name} on ${nsg##*/}" >&2
      fi
    done
  done < <(az network nic list -g "$rg" \
             --query "[].networkSecurityGroup.id" -o tsv 2>/dev/null | sort -u)
  [ "$found" = 1 ] || { echo "no NSG found in resource group '${rg}'" >&2; return 1; }
}

# dmosh <host> [mosh args...] : if <host> is a known Azure host, open the current
# IP on its NSG first; then mosh in. Unknown hosts just mosh directly.
dmosh() {
  local name="$1"
  [ -n "$name" ] || { echo "usage: dmosh <host> [mosh args...]" >&2; return 2; }
  shift
  command -v mosh >/dev/null 2>&1 || { echo "mosh not installed" >&2; return 1; }
  local entry="${DMOSH_HOSTS[$name]:-}"
  if [ -n "$entry" ]; then
    # entry is "<vm> <resource-group>"; word-splitting is intentional here.
    az_vm_allow_current_ip $entry || echo "dmosh: whitelist failed, connecting anyway" >&2
  fi
  mosh "$name" "$@"
}

# azzh <host> [ssh args...] : Azure-native SSH (AAD/certificate auth via
# `az ssh vm`) to a known Azure host, whitelisting the current IP on its NSG
# first. Needs an entry in DMOSH_HOSTS (the private overlay).
azzh() {
  local name="$1"
  [ -n "$name" ] || { echo "usage: azzh <host> [ssh args...]" >&2; return 2; }
  shift
  command -v az >/dev/null 2>&1 || { echo "az CLI not installed" >&2; return 1; }
  local entry="${DMOSH_HOSTS[$name]:-}"
  [ -n "$entry" ] || { echo "azzh: '$name' is not a known Azure host (see DMOSH_HOSTS)" >&2; return 1; }
  local vm="${entry%% *}" rg="${entry##* }"
  az_vm_allow_current_ip "$vm" "$rg" || echo "azzh: whitelist failed, connecting anyway" >&2
  az ssh vm -g "$rg" -n "$vm" --local-user "${AZ_SSH_USER:-$USER}" "$@"
}
